DESTINATION_FOLDER=
DRY_RUN=true
LOG_LEVEL=INFO
EXIFTOOL_PATH=/opt/homebrew/bin/exiftool
FILENAME_PREFIX=
HASH_LENGTH=12
INFER_TIMEZONE_FROM_IPHONE=true
CANON_HOME_TIMEZONE=Europe/Helsinki
ALLOWED_PHOTO_EXTENSIONS=jpg,jpeg,heic,png,dng,arw,cr2,nef
ALLOWED_VIDEO_EXTENSIONS=mov,mp4,m4v,avi,mkv
IGNORED_FOLDERS=.git,.svn,.hg,__pycache__,@eaDir,System Volume Information,$RECYCLE.BIN
